#!/usr/bin/env bash
#
# faa — a tiny git abstraction for the "verify agent work from one main repo" loop.
#
# Topology: one primary ("main") worktree + N linked git worktrees (shared .git),
# each on its own feature branch. Main can't check out / move a branch that a
# worktree holds, so for feature branch B it works on a *mirror* branch faa-<B>.
# Commits flow as fast-forwards between B (owned by the worktree) and faa-<B>
# (owned by main). See README.md for the full model.
#
# Single file, no deps beyond git (2.31+) + the coreutils shipped with Git Bash.
#
# Speed: every process costs tens of ms (far more on Windows), so faa reads the
# repo's state up front in three git calls run side by side (load_state), and
# the flows work from that instead of asking git again. Keep it that way:
# prefer the cached state and bash builtins over new git calls, subshells and
# pipelines.

set -uo pipefail

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------
info()  { printf '%s\n' "$*"; }
warn()  { printf 'faa: %s\n' "$*" >&2; }
die()   { printf 'faa: %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Config — read from git config, so a repo's .git/config overrides ~/.gitconfig:
#   faa.mirrorBranchPrefix  prefix for the per-feature mirror branches main
#                           checks out (default "faa-"). Feature branches must
#                           NOT start with it.
#   faa.commitPrefix        prefix for auto-generated commit messages
#                           (default "faa: "; may be empty).
# ---------------------------------------------------------------------------
MIRROR_PREFIX=faa-
COMMIT_PREFIX='faa: '
MAIN_BARE=0     # core.bare: main is a bare repo, with no working tree
AUTO_MAINT=1    # maintenance.auto: run git's auto-maintenance after commits

short() { git rev-parse --short "$1" 2>/dev/null; }

is_mirror() { case "$1" in "$MIRROR_PREFIX"*) return 0;; *) return 1;; esac; }

# True when <dir> (default: here) has uncommitted changes. A check started
# earlier with dirty_start (on fd 6) is used when there is one, so its cost
# overlaps other work. --no-optional-locks keeps status off the index lock,
# which a git command running alongside it may need.
DIRTY_DIR=''
dirty_start() { # <dir>
    exec 6< <(git -C "$1" --no-optional-locks status --porcelain 2>/dev/null)
    DIRTY_DIR=$1
}
is_dirty() { # [dir]
    local dir=${1:-.} line=''
    [ "$DIRTY_DIR" = "$dir" ] || dirty_start "$dir"
    IFS= read -r line <&6
    exec 6<&-
    DIRTY_DIR=''
    [ -n "$line" ]
}

# ---------------------------------------------------------------------------
# Repo state
# ---------------------------------------------------------------------------
TOP=            # this working tree's root
COMMON_DIR=     # the shared .git dir
MAIN_PATH=      # where git places the primary worktree ("main")
IN_MAIN=0       # 1 when running from main
CUR=            # branch checked out here ("" when detached)
# Local branches, most recently committed first, as parallel arrays: name,
# sha, short sha, and the worktree it's checked out in ("" if none).
R_NAME=() R_SHA=() R_SHORT=() R_WT=()

# Read the repo layout, config and (with "refs") the branches. The three git
# calls are independent, so they run side by side, on fds 3-5.
load_state() { # [refs]
    exec 3< <(git rev-parse --path-format=absolute --git-dir --git-common-dir --show-toplevel)
    exec 4< <(git config --get-regexp \
        '^(faa\.(mirrorbranchprefix|commitprefix)|core\.bare|maintenance\.auto)$' 2>/dev/null)
    [ "${1:-}" = refs ] && exec 5< <(git for-each-ref --sort=-committerdate refs/heads 2>/dev/null \
        --format='%(HEAD)%09%(refname:lstrip=2)%09%(objectname)%09%(objectname:short)%09%(worktreepath)')
    read_repo <&3
    read_config <&4
    [ "${1:-}" = refs ] && read_refs <&5
    exec 3<&- 4<&- 5<&-
}

# Main is the worktree whose git dir is the common one. Its path is the common
# dir minus "/.git", the same way git derives it for `git worktree list`.
# rev-parse fails outside a work tree, and on an unreadable config; git has
# already said why.
read_repo() {
    local gitdir='' common=''
    IFS= read -r gitdir; IFS= read -r common; IFS= read -r TOP
    [ -n "$TOP" ] || exit 1
    COMMON_DIR=$common
    [ "$gitdir" = "$common" ] && IN_MAIN=1
    MAIN_PATH=${common%/.git}
}

# The last value of a key wins, as with `git config --get`. Keys come back
# lowercased.
read_config() {
    local line key val
    while IFS= read -r line; do
        key=${line%% *}; val=${line#"$key"}; val=${val# }
        case "$key" in
            faa.mirrorbranchprefix) MIRROR_PREFIX=$val ;;
            faa.commitprefix)       COMMIT_PREFIX=$val ;;
            core.bare)        case "$val" in true|yes|on|1|'') MAIN_BARE=1 ;; *) MAIN_BARE=0 ;; esac ;;
            maintenance.auto) case "$val" in false|no|off|0) AUTO_MAINT=0 ;; *) AUTO_MAINT=1 ;; esac ;;
        esac
    done
    # An empty prefix would make every branch look like a mirror.
    [ -n "$MIRROR_PREFIX" ] || die "faa.mirrorBranchPrefix must not be empty."
    [ "$MIRROR_PREFIX" = faa- ] || git check-ref-format --branch "${MIRROR_PREFIX}x" >/dev/null 2>&1 \
        || die "faa.mirrorBranchPrefix '$MIRROR_PREFIX' isn't valid in a branch name."
}

read_refs() {
    local head name sha short wt
    while IFS=$'\t' read -r head name sha short wt; do
        R_NAME+=("$name"); R_SHA+=("$sha"); R_SHORT+=("$short"); R_WT+=("$wt")
        [ "$head" = '*' ] && CUR=$name
    done
}

# Look up local branch <name>: sets SHA, SHORT and WT, or returns 1.
find_ref() {
    local i
    for ((i = 0; i < ${#R_NAME[@]}; i++)); do
        if [ "${R_NAME[i]}" = "$1" ]; then
            SHA=${R_SHA[i]} SHORT=${R_SHORT[i]} WT=${R_WT[i]}
            return 0
        fi
    done
    SHA='' SHORT='' WT=''
    return 1
}

# The branch main has checked out, into MAIN_CUR ("" when detached).
main_branch() {
    local i
    MAIN_CUR=''
    if [ "$IN_MAIN" = 1 ]; then MAIN_CUR=$CUR; return; fi
    for ((i = 0; i < ${#R_NAME[@]}; i++)); do
        [ "${R_WT[i]}" = "$MAIN_PATH" ] && { MAIN_CUR=${R_NAME[i]}; return; }
    done
}

# Feature branches checked out in *linked* worktrees (not main, not mirrors),
# most recently committed first: up to <n> of them into FEATS.
linked_features() { # <n>
    local i
    FEATS=()
    for ((i = 0; i < ${#R_NAME[@]} && ${#FEATS[@]} < $1; i++)); do
        [ -n "${R_WT[i]}" ] && [ "${R_WT[i]}" != "$MAIN_PATH" ] || continue
        is_mirror "${R_NAME[i]}" || FEATS+=("${R_NAME[i]}")
    done
}

# How a mirror relates to its feature, given both shas, into REL: same,
# behind (mirror is an ancestor of the feature: fast-forwardable), ahead (the
# feature is an ancestor of the mirror: main has unpulled pushes) or diverged.
# One merge-base call answers all of them.
relate() { # <mirror-sha> <feature-sha>
    local base
    if [ "$1" = "$2" ]; then REL=same; return; fi
    base=$(git merge-base "$1" "$2" 2>/dev/null)
    if   [ "$base" = "$1" ]; then REL=behind
    elif [ "$base" = "$2" ]; then REL=ahead
    else REL=diverged; fi
}

# Relation of <feature>'s mirror to it, into REL; "none" if there's no mirror.
# With <dir>, a pull into <dir> is on the cards when they differ, so its dirty
# check starts alongside the merge-base.
mirror_rel() { # <feature> [dir]
    local m
    find_ref "$MIRROR_PREFIX$1" || { REL=none; return; }
    m=$SHA
    find_ref "$1"
    [ -z "${2:-}" ] || [ "$m" = "$SHA" ] || dirty_start "$2"
    relate "$m" "$SHA"
}

# Worktree side: the checked-out feature branch, or die.
require_feature() {
    [ -n "$CUR" ] || die "detached HEAD — checkout your feature branch first."
    is_mirror "$CUR" && die "feature branch '$CUR' must not start with '$MIRROR_PREFIX'."
}

# Stage everything and commit it. The message is a timestamp + a short
# changed-file summary. Returns 1, committing nothing, when there's nothing to
# commit; otherwise sets COMMIT_SHORT to the new commit's short sha.
commit_all() {
    local -a files=()
    local f ts list='' out line
    git add -A || die "could not stage your changes."
    while IFS= read -r f; do files+=("$f"); done < <(git diff --cached --name-only)
    [ "${#files[@]}" -gt 0 ] || return 1
    printf -v ts '%(%Y-%m-%d %H:%M:%S)T' -1 2>/dev/null || ts=$(date '+%Y-%m-%d %H:%M:%S')
    for f in "${files[@]:0:5}"; do list+="${list:+, }$f"; done
    [ "${#files[@]}" -gt 5 ] && list+=" (+$((${#files[@]} - 5)) more)"
    out=$(git -c maintenance.auto=false commit -m "$COMMIT_PREFIX$ts | ${#files[@]} file(s): $list") \
        || die "commit failed"
    # git would run auto-maintenance here and wait for it to start; start it
    # in the background instead. It drops a pending dirty check's pipe (fd 6),
    # which it would otherwise hold open, and that status blocked, while it
    # runs.
    if [ "$AUTO_MAINT" = 1 ]; then
        ( exec 6<&-; exec git maintenance run --auto --quiet --detach ) </dev/null >/dev/null 2>&1 &
    fi
    # The summary line is "[<branch> <short sha>] <subject>" — read the sha
    # from it instead of asking git again.
    line=${out%%$'\n'*}; line=${line%%"] "*}; COMMIT_SHORT=${line##* }
    case "$COMMIT_SHORT" in ''|*[!0-9a-f]*) COMMIT_SHORT=$(short HEAD) ;; esac
    return 0
}

# Try to fast-forward the branch checked out in <dir> to <target>. git carries
# uncommitted edits along by itself, as long as they don't touch files the
# merge changes. Sets FF_MOVED=1 if the branch moved (0: already up to date),
# or FF_ERR to git's complaint when it fails. Merges skip auto-maintenance: a
# fast-forward writes no objects, and the commits around it trigger it anyway.
ff_try() { # <dir> <target>
    local out
    FF_MOVED=0
    # C locale: the "Updating a..b" line is how we tell that it moved.
    out=$(LC_ALL=C git -C "$1" -c maintenance.auto=false merge --ff-only --no-stat "$2" 2>&1) \
        || { FF_ERR=$out; return 1; }
    case "$out" in *Updating*) FF_MOVED=1 ;; esac
    return 0
}

# Fast-forward <dir> to <target>, which is known to be possible, keeping
# uncommitted edits on top. <dirty> is 0/1 when the caller already knows.
# Returns 1 if the merge fails, 2 if the edits conflict with what came in
# (markers left in the files).
ff_carry() { # <dir> <target> [dirty]
    ff_try "$1" "$2" || ff_stash "$@"
}

# ff_try failed: if uncommitted edits were in the way, stash them around the
# merge (the pop merges them back 3-way). Returns as ff_carry.
ff_stash() { # <dir> <target> [dirty]
    local dir=$1 target=$2 dirty=${3:-}
    if [ -z "$dirty" ]; then is_dirty "$dir" && dirty=1 || dirty=0; fi
    if [ "$dirty" = 0 ]; then printf '%s\n' "$FF_ERR" >&2; return 1; fi
    git -C "$dir" stash push -q -u -m faa-autostash || return 1
    if ! git -C "$dir" -c maintenance.auto=false merge -q --ff-only "$target"; then
        git -C "$dir" stash pop -q
        return 1
    fi
    FF_MOVED=1
    git -C "$dir" stash pop || return 2
}

# ---------------------------------------------------------------------------
# Core flows
# ---------------------------------------------------------------------------

# Worktree: commit the agent's current work onto its feature branch. Returns 1
# when there was nothing to commit.
agent_commit() {
    if commit_all; then
        info "committed $COMMIT_SHORT on '$CUR'."
    else
        info "nothing to commit."
        return 1
    fi
}

# Worktree at <dir> (on <feature>): a main push is pending (the mirror is ahead
# of it). Fast-forward to the mirror, carrying uncommitted edits on top.
agent_pull() { # <dir> <feature>
    local dir=$1 feature=$2 mirror=$MIRROR_PREFIX$2 dirty=0 rc
    is_dirty "$dir" && dirty=1
    ff_carry "$dir" "$mirror" "$dirty"; rc=$?
    [ "$rc" -eq 1 ] && die "could not fast-forward '$feature' to '$mirror'"
    if [ "$rc" -eq 2 ]; then
        warn "pulled main's changes, but your edits conflict with them — resolve the markers, then run 'faa'."
        exit 1
    fi
    if [ "$dirty" -eq 1 ]; then
        info "pulled main's changes into '$feature'; your edits are restored on top — run 'faa' again to commit them."
    else
        find_ref "$mirror"
        info "pulled main's changes into '$feature' ($SHORT)."
    fi
}

# Main (the working tree at <dir>): follow <feature> on its mirror — switch to
# the mirror (creating it if needed) and fast-forward it to the feature,
# carrying main's uncommitted edits on top. Refuses to switch away from
# uncommitted work: it belongs to the feature being left. <rel> is the
# mirror's relation to the feature (see relate) when the caller already knows
# it. Warns and returns 1 on failure; sets FOLLOW_SHORT to the mirror's short
# sha after.
main_follow() { # <dir> <feature> [rel]
    local dir=$1 feature=$2 rel=${3:-} mirror=$MIRROR_PREFIX$2 fsha fshort msha='' rc
    find_ref "$feature" || { warn "no such feature branch: $feature"; return 1; }
    fsha=$SHA fshort=$SHORT
    find_ref "$mirror" && { msha=$SHA; FOLLOW_SHORT=$SHORT; }
    main_branch
    if [ "$MAIN_CUR" != "$mirror" ]; then
        # Switching. The dirty check overlaps the merge-base.
        [ "$DIRTY_DIR" = "$dir" ] || dirty_start "$dir"
        [ -z "$msha" ] || [ -n "$rel" ] || { mirror_rel "$feature"; rel=$REL; }
        if is_dirty "$dir"; then
            if is_mirror "$MAIN_CUR"; then
                warn "uncommitted changes on '${MAIN_CUR#"$MIRROR_PREFIX"}' — 'faa push' or stash them before switching to '$feature'."
            else
                warn "uncommitted changes on '$MAIN_CUR' — commit or stash them before switching to '$feature'."
            fi
            return 1
        fi
        if [ -z "$msha" ]; then
            git -C "$dir" checkout -q -b "$mirror" "$feature" || { warn "could not create mirror '$mirror'"; return 1; }
            FOLLOW_SHORT=$fshort
        elif [ "$rel" = behind ]; then
            # Clean, so switch and fast-forward in one checkout.
            git -C "$dir" checkout -q -B "$mirror" "$feature" || { warn "could not checkout '$mirror'"; return 1; }
            FOLLOW_SHORT=$fshort
        else
            git -C "$dir" checkout -q "$mirror" || { warn "could not checkout '$mirror'"; return 1; }
        fi
    elif [ "$rel" = behind ] || { [ -z "$rel" ] && [ "$msha" != "$fsha" ]; }; then
        # On the mirror already: pull. Rather than ask how the two relate
        # first, just try — a fast-forward is the usual case — and only ask
        # when it fails.
        if ff_try "$dir" "$feature"; then
            [ "$FF_MOVED" = 1 ] && FOLLOW_SHORT=$fshort
        else
            [ -n "$rel" ] || { mirror_rel "$feature"; rel=$REL; }
            if [ "$rel" = behind ]; then
                # It's possible, so local edits were in the way.
                ff_stash "$dir" "$feature"; rc=$?
                [ "$rc" -eq 1 ] && { warn "could not fast-forward '$mirror'"; return 1; }
                if [ "$rc" -eq 2 ]; then
                    warn "pulled, but your local edits conflict — resolve the markers, then 'faa push' when ready."
                    return 1
                fi
                FOLLOW_SHORT=$fshort
            elif [ "$rel" != diverged ]; then
                printf '%s\n' "$FF_ERR" >&2
                warn "could not fast-forward '$mirror'"
                return 1
            fi
        fi
    fi
    # same / ahead (main has unpushed work): nothing to pull.
    [ "$rel" = diverged ] && warn "mirror '$mirror' and '$feature' have diverged; leaving mirror unchanged."
    return 0
}

# Main: bare `faa` — follow the newest finished worktree. Pull it if main is
# already on it, otherwise switch to it.
main_pull() {
    linked_features 1
    [ "${#FEATS[@]}" -gt 0 ] || die "no agent worktrees found to verify."
    main_follow "$TOP" "${FEATS[0]}" || exit 1
    info "main mirrors '${FEATS[0]}' as '$MIRROR_PREFIX${FEATS[0]}' ($FOLLOW_SHORT)."
}

# Main: commit main's local tweaks onto the mirror so the agent can pull them.
# Pass "quiet" to drop the "run 'faa' in the worktree" hint (faa both push).
# Returns 1 when there was nothing to push; leaves REL as the mirror's relation
# to the feature from before the push.
do_push() {
    [ "$IN_MAIN" = 1 ] || die "'faa push' is for the main repo (in a worktree, just run 'faa')."
    local feature
    is_mirror "$CUR" || die "main is not on a faa mirror — run 'faa' or 'faa -c <branch>' first."
    feature=${CUR#"$MIRROR_PREFIX"}
    find_ref "$feature" || die "feature branch '$feature' no longer exists."
    mirror_rel "$feature"
    case "$REL" in
        same|ahead) ;;
        *) die "worktree has new commits on '$feature' — run 'faa' to pull them first." ;;
    esac
    if ! commit_all; then info "nothing to push."; return 1; fi
    if [ "${1:-}" = quiet ]; then info "pushed $COMMIT_SHORT on '$CUR'."
    else info "pushed $COMMIT_SHORT on '$CUR' — run 'faa' in the worktree to pull."; fi
}

# Bare `faa`: behavior depends on where it runs.
bare_faa() {
    if [ "$IN_MAIN" = 1 ]; then
        main_pull
        return
    fi
    require_feature
    mirror_rel "$CUR" .
    if [ "$REL" = ahead ]; then
        agent_pull . "$CUR"         # mirror is ahead of B → pull main's push
    else
        agent_commit || true        # otherwise → save the agent's work
    fi
}

# `faa both` — do this side's step, then the other side's, so you don't have to
# switch terminals. Each half is the same step the ordinary command takes,
# pointed at the other worktree's directory, so its guards and messages are
# unchanged.
do_both() {
    case "${1:-}" in
        '')   both_save ;;
        push) both_push ;;
        *)    die "unknown: faa both $1 (try 'faa both' or 'faa both push')." ;;
    esac
}

# Worktree: `faa`, then `faa -c <this branch>` in main. Main follows *this*
# branch, not the newest worktree. If `faa` pulled main's push instead of
# saving, main already has those commits, so we stop there.
both_save() {
    [ "$IN_MAIN" = 1 ] && die "'faa both' runs from a worktree (in main, 'faa both push' sends your tweaks to the agent)."
    require_feature
    # Before touching anything, so a bad setup fails early: a main made with
    # --separate-git-dir (no "/.git" to strip) or a bare one has no working
    # tree to pull into.
    [ "$MAIN_PATH" != "$COMMON_DIR" ] && [ "$MAIN_BARE" = 0 ] \
        || die "can't locate the main repo's working tree (git reports '$MAIN_PATH')."
    local feature=$CUR rel
    mirror_rel "$feature" .
    if [ "$REL" = ahead ]; then
        agent_pull . "$feature"
        info "main already has these commits — run 'faa both' again to save your edits and send them to main."
        return 0
    fi
    rel=$REL
    # Main's dirty check (only needed to switch it) overlaps the commit.
    main_branch
    [ "$MAIN_CUR" = "$MIRROR_PREFIX$feature" ] || dirty_start "$MAIN_PATH"
    # A new commit sits on top of the old tip, so a mirror that was at (or
    # behind) the tip is now behind it — no need to ask git again.
    if agent_commit && [ "$rel" = same ]; then rel=behind; fi
    [ "$rel" = none ] && rel=''
    main_follow "$MAIN_PATH" "$feature" "$rel" \
        || die "saved on '$feature', but main's step failed (see above)."
    info "main now mirrors '$feature' as '$MIRROR_PREFIX$feature'."
}

# Main: `faa push`, then pull it into the worktree. The worktree is only touched
# when it's clean: the agent may be writing there, and a conflict would leave
# markers where you aren't looking.
both_push() {
    [ "$IN_MAIN" = 1 ] || die "'faa both push' is for the main repo (in a worktree, use 'faa both')."
    local feature=${CUR#"$MIRROR_PREFIX"} wt mshort
    # The worktree's dirty check doesn't depend on the push: start it now.
    is_mirror "$CUR" && find_ref "$feature" && [ -d "$WT" ] && dirty_start "$WT"
    if do_push quiet; then
        mshort=$COMMIT_SHORT        # the mirror is now ahead of the feature
    else
        [ "$REL" = ahead ] || { info "worktree '$feature' is already up to date."; return 0; }
        find_ref "$CUR"; mshort=$SHORT
    fi
    find_ref "$feature"; wt=$WT
    [ -n "$wt" ] || { info "no worktree has '$feature' checked out — nothing else to update."; return 0; }
    [ -d "$wt" ] || die "worktree for '$feature' is missing at '$wt' (moved? try 'git worktree repair')."
    is_dirty "$wt" \
        && die "worktree '$feature' has uncommitted changes, so it was left alone — run 'faa' there to pull."
    ff_carry "$wt" "$CUR" 0 || die "could not fast-forward '$feature' to '$CUR'"
    info "pulled main's changes into '$feature' ($mshort)."
}

# `faa reset` — declare the current state as truth and record a marker for the
# other side to adopt with `faa reset sync`.
do_reset() {
    local feature at
    if [ "$IN_MAIN" = 1 ]; then
        is_mirror "$CUR" || die "main is not on a faa mirror — run 'faa' or 'faa -c <branch>' first."
        feature=${CUR#"$MIRROR_PREFIX"}
    else
        [ -n "$CUR" ] || die "detached HEAD."
        is_mirror "$CUR" && die "feature branch '$CUR' must not start with '$MIRROR_PREFIX'."
        feature=$CUR
    fi
    if commit_all; then at=$COMMIT_SHORT; else find_ref "$CUR"; at=$SHORT; fi
    git update-ref "refs/faa/reset/${feature//\//-}" HEAD || die "could not record the reset marker."
    if [ "$IN_MAIN" = 1 ]; then
        info "reset marker for '$feature' recorded at $at. In the worktree, run 'faa reset sync'."
    else
        info "branch '$feature' reset to $at. On main, run 'faa reset sync'."
    fi
}

# `faa reset sync` — hard-reset the branch this side owns to the latest marker.
do_reset_sync() {
    local feature marker at
    if [ "$IN_MAIN" = 1 ]; then
        is_mirror "$CUR" || die "main is not on a faa mirror."
        feature=${CUR#"$MIRROR_PREFIX"}
    else
        [ -n "$CUR" ] || die "detached HEAD."
        feature=$CUR
    fi
    marker="refs/faa/reset/${feature//\//-}"
    at=$(git rev-parse --verify --quiet --short "$marker") \
        || die "no reset marker for '$feature' — run 'faa reset' on the other side first."
    git reset -q --hard "$marker" || die "reset failed."
    info "'$CUR' hard-reset to $at (prior tip kept in reflog)."
}

# ---------------------------------------------------------------------------
# faa loop — run the same command in N throwaway worktrees
# ---------------------------------------------------------------------------
# Each run gets a detached worktree at the current commit and runs your command
# in it; faa doesn't care what the command is (an agent, a chain of agents, a
# plain script). Each run's stdout is saved as summary-<ts>/run-N.md, so
# whatever the command prints is the run's summary — route anything you don't
# want in it to stderr.
#
# By default the worktrees are a persistent, reused pool (.faa-loop-pool/wt-N):
# reset --hard + clean -fdx is cheaper than a fresh checkout since only what
# differs gets rewritten, and it leaves each run's work in place to inspect
# until the next loop. N can change freely between runs — extra slots are
# created on demand, fewer-than-before slots just sit unused. --no-reuse goes
# back to throwaway worktrees, created fresh under the summary dir and removed
# after. Only meant for one `faa loop` at a time against a given pool —
# concurrent loops should each pass --no-reuse.
# `faa loop --clean` — tear the pool down. Each run's work lives in its slot
# until the next loop reclaims it, so this discards whatever is still there.
clean_pool() {
    [ "$IN_MAIN" = 1 ] || die "'faa loop --clean' is for the main repo."
    local pool wt n=0
    pool="$TOP/.faa-loop-pool"
    [ -d "$pool" ] || { info "no worktree pool to clean."; return 0; }
    for wt in "$pool"/wt-*; do
        [ -e "$wt" ] || continue
        git worktree remove --force "$wt" >/dev/null 2>&1
        rm -rf "$wt"
        n=$((n + 1))
    done
    rm -rf "$pool"
    git worktree prune >/dev/null 2>&1
    info "removed $n pool worktree(s) (.faa-loop-pool)."
}

ensure_pool_worktree() {
    local wt="$1" sha="$2"
    if git -C "$wt" rev-parse --git-dir >/dev/null 2>&1; then
        if git -C "$wt" clean -fdx -q >/dev/null 2>&1 \
            && git -C "$wt" reset --hard -q "$sha" >/dev/null 2>&1; then
            return 0
        fi
        git worktree remove --force "$wt" >/dev/null 2>&1
    fi
    rm -rf "$wt"
    git worktree add -q -d "$wt" "$sha" || die "could not create worktree $wt"
}

do_loop() {
    [ "$IN_MAIN" = 1 ] || die "'faa loop' is for the main repo."
    local n=5 seq=0 reuse=1
    local -a cmd=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -n)          [ -n "${2:-}" ] || die "faa loop: -n needs a number"; n="$2"; shift 2 ;;
            --seq)       seq=1; shift ;;
            --no-reuse)  reuse=0; shift ;;
            --clean)     shift; [ $# -eq 0 ] || die "faa loop: --clean takes no other arguments"; clean_pool; return ;;
            --)          shift; cmd=("$@"); break ;;
            *)           die "unknown: faa loop $1 (try 'faa -h')" ;;
        esac
    done
    case "$n" in ''|*[!0-9]*) die "faa loop: -n must be a number, got '$n'";; esac
    [ "$n" -ge 1 ] || die "faa loop: -n must be at least 1"
    [ "${#cmd[@]}" -gt 0 ] || die "faa loop: no command — end the options with '-- <cmd> [args...]'"

    local sha root out id excl
    sha=$(git rev-parse --verify --quiet 'HEAD^{commit}') || die "no commit to run from."
    root=$TOP
    id="summary-$(date +%Y%m%d-%H%M%S)"
    out="$root/$id"
    local k=1
    while [ -e "$out" ]; do out="$root/$id-$k"; k=$((k + 1)); done
    id="${out##*/}"
    mkdir -p "$out"

    # Keep faa's own dirs out of git status without touching tracked files.
    excl="$COMMON_DIR/info/exclude"
    grep -qxF 'summary-*/' "$excl" 2>/dev/null || printf 'summary-*/\n' >> "$excl"
    grep -qxF '.faa-loop-pool/' "$excl" 2>/dev/null || printf '.faa-loop-pool/\n' >> "$excl"

    git worktree prune >/dev/null 2>&1

    local i wtdir
    if [ "$reuse" -eq 1 ]; then
        wtdir="$root/.faa-loop-pool"
        mkdir -p "$wtdir"
        info "faa loop: $n run(s) from $(short "$sha") -> $id/ (reusing $wtdir)"
        for i in $(seq 1 "$n"); do
            ensure_pool_worktree "$wtdir/wt-$i" "$sha"
        done
    else
        wtdir="$out"
        info "faa loop: $n run(s) from $(short "$sha") -> $id/"
        for i in $(seq 1 "$n"); do
            git worktree add -q -d "$wtdir/wt-$i" "$sha" || die "could not create worktree wt-$i"
        done
    fi

    # Runs go in parallel unless --seq. stdin is /dev/null so a command that
    # waits for input fails fast instead of hanging.
    for i in $(seq 1 "$n"); do
        ( cd "$wtdir/wt-$i" && "${cmd[@]}"; printf '%s\n' "$?" > "$out/.rc-$i" ) \
            </dev/null >"$out/run-$i.md" &
        [ "$seq" -eq 1 ] && wait
    done
    wait

    local rc
    for i in $(seq 1 "$n"); do
        rc=$(cat "$out/.rc-$i" 2>/dev/null); rm -f "$out/.rc-$i"
        if [ "${rc:-1}" -eq 0 ] 2>/dev/null; then
            info "  run $i: ok  (run-$i.md)"
        else
            warn "run $i exited with ${rc:-?}  (run-$i.md)"
        fi
        [ "$reuse" -eq 0 ] && git worktree remove --force "$wtdir/wt-$i" >/dev/null 2>&1
    done
    git worktree prune >/dev/null 2>&1
    info "summaries: $id/"
}

# ---------------------------------------------------------------------------
# Listing / picking / checkout
# ---------------------------------------------------------------------------
print_feature_line() {
    local i="$1" f="$2" state wt
    find_ref "$f"; wt=$WT
    if find_ref "$MIRROR_PREFIX$f"; then state="$MIRROR_PREFIX$f"; else state="(no mirror yet)"; fi
    printf '%2d) %-22s  mirror: %-24s  %s\n' "$i" "$f" "$state" "$wt"
}

list_count() { # <n>
    case "$1" in ''|*[!0-9]*) die "not a number: $1";; esac
}

list_worktrees() {
    local n="${1:-5}" i
    list_count "$n"
    linked_features "$n"
    [ "${#FEATS[@]}" -gt 0 ] || { info "no agent worktrees in work."; return 0; }
    for ((i = 0; i < ${#FEATS[@]}; i++)); do print_feature_line "$((i + 1))" "${FEATS[i]}"; done
}

checkout_feature() {
    [ "$IN_MAIN" = 1 ] || die "'faa -c' is for the main repo."
    local feature="$1"
    is_mirror "$feature" && feature=${feature#"$MIRROR_PREFIX"}
    find_ref "$feature" || die "no such feature branch: $feature"
    main_follow "$TOP" "$feature" || exit 1
    info "main now mirrors '$feature' as '$MIRROR_PREFIX$feature'."
}

pick_worktree() {
    [ "$IN_MAIN" = 1 ] || die "'faa -p' is for the main repo."
    local n="${1:-5}" i choice
    list_count "$n"
    linked_features "$n"
    [ "${#FEATS[@]}" -gt 0 ] || die "no agent worktrees in work."
    for ((i = 0; i < ${#FEATS[@]}; i++)); do print_feature_line "$((i + 1))" "${FEATS[i]}"; done
    printf 'Pick a number: '
    IFS= read -r choice || die "no selection."
    case "$choice" in
        ''|*[!0-9]*) die "not a number: $choice";;
    esac
    [ "$choice" -ge 1 ] && [ "$choice" -le "${#FEATS[@]}" ] || die "out of range: $choice"
    checkout_feature "${FEATS[$((choice - 1))]}"
}

usage() {
    cat <<EOF
faa — manage the worktree <-> main verify loop (no raw git needed)

USAGE
  faa                 In a worktree: save your work (commit), OR if main pushed,
                      pull that first (then run 'faa' again to save your edits).
                      In main: pull the latest work for the feature you verify.
  faa push            In main: commit your local tweaks so the agent can pull them.
  faa both            In a worktree: 'faa' here, then 'faa -c <this branch>' in
                      main — save and hand off in one step.
  faa both push       In main: 'faa push', then pull it into the worktree (only
                      if the worktree has no uncommitted changes).
  faa reset           Declare the current state as truth; tell the other side to sync.
  faa reset sync      Adopt the other side's latest reset (hard reset — discards
                      local changes on this side).

  faa loop [opts] -- CMD [ARGS...]
                      In main: run CMD in N worktrees at the current commit.
                      Each run's stdout is saved as run-N.md in a fresh
                      summary-<timestamp>/ dir (stderr passes through to you).
      -n N            number of runs (default 5)
      --seq           run one at a time (default: all in parallel)
      --no-reuse      use fresh throwaway worktrees instead of the persistent
                      pool (.faa-loop-pool/), removed once the run is done
  faa loop --clean    In main: remove the worktree pool, discarding the work
                      still sitting in it from the last loop.

  faa -l, --list [N]      List the last N worktrees in work (default 5).
  faa -p, --pick [N]      List the last N and pick one to verify (main).
  faa -c, --checkout B    Verify feature branch B in main (creates mirror ${MIRROR_PREFIX}B).
  faa -h, --help          Show this help.

Mirror prefix: ${MIRROR_PREFIX} (git config faa.mirrorBranchPrefix to change).
Feature branches must not start with that prefix.
EOF
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
main() {
    case "${1:-}" in
        loop|-h|--help) load_state ;;
        *)              load_state refs ;;
    esac
    case "${1:-}" in
        '')               bare_faa ;;
        push)             do_push || true ;;
        both)             shift; do_both "$@" ;;
        loop)             shift; do_loop "$@" ;;
        reset)
            if [ "${2:-}" = "sync" ]; then do_reset_sync
            elif [ -z "${2:-}" ];     then do_reset
            else die "unknown: faa reset ${2}"; fi ;;
        -l|--list)        list_worktrees "${2:-5}" ;;
        -p|--pick)        pick_worktree "${2:-5}" ;;
        -c|--checkout)    [ -n "${2:-}" ] || die "usage: faa -c <branch>"; checkout_feature "$2" ;;
        -h|--help)        usage ;;
        *)                die "unknown command: $1 (try 'faa -h')." ;;
    esac
}

main "$@"
